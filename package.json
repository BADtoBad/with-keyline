{
  "name": "with-keyline",
  "version": "1.0.1",
  "private": true,
  "description": "With Keyline — writing and navigation tools to pair with the Keyline theme",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs test && node --test test/*.test.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "16.18.11",
    "esbuild": "0.17.3",
    "obsidian": "1.13.1",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@lezer/markdown": "1.8.0"
  }
}
